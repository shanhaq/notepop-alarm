<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scrim"
    android:clickable="true"
    android:focusable="true">

    <!-- Full-screen glass popup (alarm) -->
    <FrameLayout
        android:id="@+id/glassPopup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="20dp"
        android:animateLayoutChanges="true"
        android:clipToPadding="false"
        android:padding="8dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_popup_bg"
            android:clipToOutline="true"
            android:foreground="@drawable/glass_reflection"
            android:outlineProvider="background"
            android:paddingStart="25dp"
            android:paddingTop="38dp"
            android:paddingEnd="25dp"
            android:paddingBottom="28dp">

            <!-- Neon edge strip top -->
            <View
                android:layout_width="160dp"
                android:layout_height="2dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="12dp"
                android:layout_marginTop="-1dp"
                android:background="#7CE8FF"
                android:elevation="2dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="82dp"
                    android:layout_height="82dp"
                    android:layout_marginBottom="25dp"
                    android:background="@drawable/icon_circle_bg"
                    android:elevation="4dp">

                    <ImageView
                        android:layout_width="37dp"
                        android:layout_height="37dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/alarm_sound"
                        android:src="@drawable/ic_notification_bell" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/app_name"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="26dp"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/note_hint"
                    android:textColor="#E6FFFFFF"
                    android:textSize="16sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStop"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/btn_open_bg"
                    android:text="@string/stop_alarm"
                    android:textAllCaps="false"
                    android:textColor="@color/on_accent"
                    android:textSize="16sp"
                    app:backgroundTint="@null" />
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
</FrameLayout>